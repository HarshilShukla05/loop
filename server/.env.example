PORT=8080
DATABASE_URL=postgres://loop:loop@localhost:5432/loop?sslmode=disable
TEST_DATABASE_URL=postgres://loop:loop@localhost:5432/loop_test?sslmode=disable
DASHBOARD_URL=http://localhost:5173
# marketing/landing site that hosts /privacy, /terms, /data-deletion
MARKETING_URL=http://localhost:3000

META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_REDIRECT_URI=http://localhost:8080/auth/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=dev-verify-token
GRAPH_API_VERSION=v23.0

# 32-byte base64 key for token-at-rest encryption (AES-256-GCM): openssl rand -base64 32
TOKEN_ENC_KEY=
# secret used to sign the session cookie: openssl rand -base64 32
SESSION_SECRET=
# true in production (HTTPS); false for local http
COOKIE_SECURE=false
# enables POST /auth/dev-login for local testing without Meta
DEV_AUTH=true
