# Production env for the Loop server → lives at /opt/loop/.env on the VM
# (0640, owned by loop). NEVER commit the real file; this is the template.
# Generate secrets fresh for prod:
#   TOKEN_ENC_KEY:  openssl rand -base64 32
#   SESSION_SECRET: openssl rand -base64 32
#   verify token:   openssl rand -base64 24 | tr -d '/+='
#   DB password:    openssl rand -base64 24 | tr -d '/+='

PORT=8080
DATABASE_URL=postgres://loop:DB_PASSWORD@localhost:5432/loop?sslmode=disable

# Single-origin: dashboard SPA + API both served from this host by Caddy.
DASHBOARD_URL=https://app.loop.lmk.co.in
MARKETING_URL=https://loop.lmk.co.in
META_REDIRECT_URI=https://app.loop.lmk.co.in/auth/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME
GRAPH_API_VERSION=v23.0

TOKEN_ENC_KEY=CHANGE_ME
SESSION_SECRET=CHANGE_ME
COOKIE_SECURE=true
DEV_AUTH=false

SEND_DRY_RUN=false
WORKER_COUNT=10
RATE_LIMIT_PER_HOUR=750
DB_MAX_CONNS=25

META_APP_ID=3897649677210395
META_APP_SECRET=CHANGE_ME
